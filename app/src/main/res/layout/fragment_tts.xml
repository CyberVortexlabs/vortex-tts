<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_cosmic_orbs"
        android:scaleType="centerCrop"
        android:alpha="1.0"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="30dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:id="@+id/headerLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Vortex TTS" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/brand_title"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:textColor="@color/cosmic_text" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تبدیل متن به صدای طبیعی"
                        android:textSize="13sp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:textColor="@color/cosmic_text_secondary" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/changeKeyButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_secondary_button"
                    android:padding="12dp"
                    android:src="@drawable/ic_tune"
                    android:contentDescription="@string/change_api_key" />
            </LinearLayout>

            <TextView
                android:id="@+id/keyWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="@drawable/bg_glass_card"
                android:text="کلید API تنظیم نشده؛ برای کیفیت بهتر کلید خود را وارد کنید."
                android:textSize="13sp"
                android:fontFamily="@font/vazirmatn_medium"
                android:textColor="@color/cosmic_warning"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card">

                <TextView
                    android:id="@+id/keySelectorLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="کلید فعال"
                    android:textSize="12sp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/cosmic_text" />

                <Spinner
                    android:id="@+id/keySelectorSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_secondary_button"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_glass_card">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/text_hint"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/textEditText"
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="5000"
                        android:fontFamily="@font/vazirmatn_regular" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/charCounter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="end"
                    android:text="0 / 5000"
                    android:textSize="12sp"
                    android:fontFamily="@font/vazirmatn_medium"
                    android:textColor="@color/cosmic_text_secondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/style_prompt"
                    android:textSize="14sp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/cosmic_text" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/styleEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:minHeight="56dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:hint="@string/style_hint"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="3"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/vazirmatn_regular" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:scrollbars="none">
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/styleChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true">
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipHappy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_happy" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCalm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_calm" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipEpic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_epic" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFormal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_formal" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSerious"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_serious" />
                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipWhisper"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sample_whisper" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/voice"
                    android:textSize="14sp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/cosmic_text" />

                <Spinner
                    android:id="@+id/directVoiceSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_secondary_button" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/previewVoiceButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="تست صدا"
                        android:textAllCaps="false"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:textColor="@color/cosmic_text"
                        android:background="@drawable/bg_secondary_button" />

                    <ProgressBar
                        android:id="@+id/voicePreviewProgress"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/voicePreviewStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:fontFamily="@font/vazirmatn_regular"
                    android:textColor="@color/cosmic_text_secondary"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/loudness"
                    android:textSize="14sp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/cosmic_text" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/loudnessChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:singleSelection="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/loudAutoChip"
                        android:checkable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/auto" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/loudNormalChip"
                        android:checkable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/normal" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/loudLoudChip"
                        android:checkable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loud" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_glass_card">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/model"
                    android:textSize="14sp"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/cosmic_text" />
                <Spinner
                    android:id="@+id/modelSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_secondary_button" />
            </LinearLayout>

            <TextView
                android:id="@+id/operationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textSize="14sp"
                android:visibility="gone"
                android:fontFamily="@font/vazirmatn_medium" />

            <ProgressBar
                android:id="@+id/ttsProgress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/generateButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:text="@string/generate_audio"
                android:textAllCaps="false"
                android:fontFamily="@font/vazirmatn_bold"
                android:textColor="@color/cosmic_text"
                android:background="@drawable/bg_primary_button" />

            <LinearLayout
                android:id="@+id/voiceBubbleCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:background="@drawable/bg_glass_card">

                <Button
                    android:id="@+id/bubblePlayButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:minWidth="96dp"
                    android:text="@string/play"
                    android:textAllCaps="false"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/cosmic_text"
                    android:background="@drawable/bg_primary_button" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/bubbleTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bubble_ready"
                        android:textSize="14sp"
                        android:fontFamily="@font/vazirmatn_bold"
                        android:textColor="@color/cosmic_text" />
                    <TextView
                        android:id="@+id/bubbleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/bubble_tap_to_play"
                        android:textSize="12sp"
                        android:fontFamily="@font/vazirmatn_regular"
                        android:textColor="@color/cosmic_text_secondary" />
                </LinearLayout>

                <Button
                    android:id="@+id/downloadButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:minWidth="96dp"
                    android:text="@string/download_audio"
                    android:textAllCaps="false"
                    android:fontFamily="@font/vazirmatn_bold"
                    android:textColor="@color/cosmic_text"
                    android:background="@drawable/bg_secondary_button" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
